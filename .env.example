# Copie para .env e preencha com os dados do seu projeto no Supabase.
# Sem estas variáveis o app roda com localStorage (um quadro por navegador,
# sem multiusuário) — útil para demonstrar sem backend nenhum.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Apenas para publicar em GitHub Pages num repositório que não seja
# <usuario>.github.io — use "/nome-do-repositorio/".
# VITE_BASE=/cpn-controle/
